# Copy to .env and update the paths. Command-line arguments take precedence, and ${VAR} can reference earlier variables.

# Storage directory for data and results
PROJECT_SCRATCH_ROOT="/path/to/large/storage/BADGE-Greedy-DPP"

# Frame-level cache directory containing HyenaSET/
CACHE_ROOT="${PROJECT_SCRATCH_ROOT}/cache"

# Experiment output directory
OUTPUT_ROOT="${PROJECT_SCRATCH_ROOT}/outputs"
